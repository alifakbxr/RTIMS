# Production Environment Variables
# Copy this to .env.production and fill in your secure values

# Database
POSTGRES_PASSWORD=your-very-secure-postgres-password-here

# JWT Secrets (use openssl rand -base64 32 to generate)
JWT_SECRET=your-production-jwt-secret-min-32-characters-long
REFRESH_SECRET=your-production-refresh-secret-min-32-chars

# Docker Registry (for CI/CD)
REGISTRY=ghcr.io
BACKEND_IMAGE=your-username/rtims/backend
FRONTEND_IMAGE=your-username/rtims/frontend

# Domain Configuration
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
