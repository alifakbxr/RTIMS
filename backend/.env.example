# Environment Configuration
ENVIRONMENT=production

# Server Configuration
PORT=8080

# Database Configuration
# Format: postgres://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://rtims_user:your_secure_password@localhost:5432/rtims?sslmode=disable

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration (CHANGE THESE IN PRODUCTION!)
# Use at least 32 characters for security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production

# Email Configuration (Optional - for password reset and notifications)
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@rtims.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Rate Limiting
RATE_LIMIT=100

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
